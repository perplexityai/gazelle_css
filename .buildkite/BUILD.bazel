load("@gazelle//:def.bzl", "gazelle_binary")

gazelle_binary(
    name = "gazelle",
    languages = ["//css"],
)

platform(
    name = "linux-amd64",
    constraint_values = ["@platforms//cpu:x86_64", "@platforms//os:linux"],
)

platform(
    name = "darwin-arm64",
    constraint_values = ["@platforms//cpu:aarch64", "@platforms//os:macos"],
)

platform(
    name = "windows-amd64",
    constraint_values = ["@platforms//cpu:x86_64", "@platforms//os:windows"],
)
