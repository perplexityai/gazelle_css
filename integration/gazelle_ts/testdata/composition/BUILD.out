load("@gazelle_ts//ts:defs.bzl", "ts_library")
load("//tools:css.bzl", "custom_css_module_library")

# gazelle:generation_mode update_only
# gazelle:css_module_enabled true
# gazelle:map_kind css_module_library custom_css_module_library //tools:css.bzl
# gazelle:resolve_regexp ts ts ^#generated/(.+)/[^/]+\.css\.js$ //$1:css.web
# gazelle:resolve_regexp ts ts ^#generated/[^/]+\.css\.js$ //:css.web

ts_library(
    name = "lib",
    srcs = ["root.ts"],
    visibility = ["//visibility:public"],
    deps = [":css.web"],
)

custom_css_module_library(
    name = "css",
    srcs = ["Root.module.css"],
)
